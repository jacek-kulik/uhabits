#!/bin/sh
# uhabits-managed-reference-transaction

# Keep a previously installed hook active, then run the repository guards.
previous="$0.previous"
input=$(mktemp "${TMPDIR:-/tmp}/uhabits-git-hook.XXXXXXXX") || exit 1
trap 'rm -f "$input"' EXIT HUP INT TERM
cat > "$input" || exit 1

if [ -x "$previous" ]; then
    previous_oid=$(git hash-object --no-filters "$previous" 2>/dev/null || true)
    # This exact hook is the repository's older standalone dev guard. The
    # current protect-dev helper supersedes it.
    if [ "$previous_oid" != 76ecbf79534289753b0f3e8c6826ee4e4485c489 ]; then
        "$previous" "$@" < "$input" || exit $?
    fi
fi
"$(dirname "$0")/protect-dev" "$@" < "$input" || exit $?
"$(dirname "$0")/prevent-unpushed-branch-delete" "$@" < "$input"
