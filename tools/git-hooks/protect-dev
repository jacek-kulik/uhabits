#!/bin/sh

[ "$1" = prepared ] || exit 0

zero=0000000000000000000000000000000000000000
while read -r old new ref; do
    [ "$ref" = refs/heads/dev ] || continue

    # pack-refs first writes the loose value to packed-refs, then removes the
    # loose copy. Permit both storage-only steps without mistaking an
    # expected-old deletion for one of them.
    loose_ref=$(git rev-parse --git-path "$ref")
    if [ "$old" = "$zero" ] && [ -f "$loose_ref" ]; then
        current=$(git rev-parse --verify "$ref^{commit}" 2>/dev/null || true)
        [ "$new" = "$current" ] && continue
    fi
    if [ "$new" = "$zero" ] && [ "$old" != "$zero" ]; then
        packed_refs=$(git rev-parse --git-path packed-refs)
        packed_tip=$(
            [ -f "$packed_refs" ] &&
                awk -v ref="$ref" '$2 == ref { print $1; exit }' "$packed_refs"
        )
        if [ -f "$loose_ref" ] && [ "$old" = "$packed_tip" ]; then
            continue
        fi
    fi

    if [ "${GIT_REFLOG_ACTION:-}" != 'pull --ff-only origin dev' ]; then
        printf '%s\n' 'Blocked update to dev: use git pull --ff-only origin dev.' >&2
        exit 1
    fi
    if [ "$old" = "$zero" ] || [ "$new" = "$zero" ] ||
        ! git merge-base --is-ancestor "$old" "$new"; then
        printf '%s\n' 'Blocked update to dev: the pull must fast-forward.' >&2
        exit 1
    fi
    remote_dev=$(git rev-parse --verify 'refs/remotes/origin/dev^{commit}' 2>/dev/null) || {
        printf '%s\n' 'Blocked update to dev: origin/dev is unavailable.' >&2
        exit 1
    }
    if [ "$new" != "$remote_dev" ]; then
        printf '%s\n' 'Blocked update to dev: the new tip must equal origin/dev.' >&2
        exit 1
    fi
done
